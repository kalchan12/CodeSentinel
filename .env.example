# CodeSentinel Environment Configuration
# Copy this file to .env to override defaults
# All variables have safe defaults defined in code, so this file is optional.

# ----------------
# Core Environment
# ----------------
CODESENTINEL_ENVIRONMENT=development
CODESENTINEL_LOG_LEVEL=INFO

# ----------------
# Database & Queue
# ----------------
CODESENTINEL_DATABASE_URL=postgresql+psycopg://codesentinel:codesentinel@localhost:5432/codesentinel
CODESENTINEL_REDIS_URL=redis://localhost:6379/0

# ----------------
# Paths & Settings
# ----------------
# Workspace for clones and local data (defaults to ~/.codesentinel on host)
# CODESENTINEL_DATA_DIR=~/.codesentinel
CODESENTINEL_ENABLED_ANALYZERS=mock
CODESENTINEL_CORS_ORIGINS=http://localhost:3000,http://localhost:1420,tauri://localhost

# ----------------
# Analyzer Configuration
# ----------------
# CODESENTINEL_SEMGREP_PATH=semgrep
# CODESENTINEL_SEMGREP_CONFIG=
# CODESENTINEL_SEMGREP_TIMEOUT=60

# CODESENTINEL_GITLEAKS_PATH=gitleaks
# CODESENTINEL_GITLEAKS_TIMEOUT=120

# CODESENTINEL_GIT_PATH=git
# CODESENTINEL_GIT_TIMEOUT=30

# ----------------
# Optional AI Enrichment
# ----------------
# CODESENTINEL_AI_API_KEY=
# CODESENTINEL_AI_BASE_URL=https://api.openai.com/v1
# CODESENTINEL_AI_MODEL=gpt-4o-mini
# CODESENTINEL_AI_TIMEOUT=120
